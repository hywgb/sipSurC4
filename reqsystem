              'max_hours_per_day': 8,
              'max_hours_per_week': 40,
              'min_break_time': 1,
              'skill_coverage': 0.8
          }

          # 优化目标
          objectives = {
              'minimize_cost': 0.4,
              'maximize_coverage': 0.3,
              'balance_workload': 0.3
          }

          # 运行优化算法
          optimal_schedule = self.run_optimization(
