      def calculate_optimal_ratio(self):
          """计算最优拨号比"""
          # 关键参数
          avg_handle_time = self.get_avg_handle_time()
          answer_rate = self.get_answer_rate()
          abandon_rate = self.get_abandon_rate()
          available_agents = self.get_available_agents()

          # 预测模型
          optimal_ratio = self.ml_model.predict({
              'time_of_day': datetime.now().hour,
              'day_of_week': datetime.now().weekday(),
              'answer_rate': answer_rate,
              'agent_count': available_agents,
              'queue_length': self.get_queue_length()
          })

          # 安全边界
          optimal_ratio = max(1.0, min(optimal_ratio, 3.0))

          # 法规合规（放弃率不超过3%）
          if abandon_rate > 0.03:
              optimal_ratio *= 0.9

          return optimal_ratio

